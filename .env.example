APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password

SESSION_DRIVER=database
# 120 = 2h. For dev, use 10080 (1 week) to avoid "Session expired" during testing
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# For local email testing without a queue worker, use sync so Accept/Resend setup email send immediately:
# QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenRouter API (for AI exam scheduling assistant; free models only)
OPENROUTER_API_KEY=
# Optional: default openrouter/free; use a specific :free model if desired
# OPENROUTER_MODEL=openrouter/free

# Login rate limiting (disable in dev with LOGIN_THROTTLE_ENABLED=false)
LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15

# Demo mode — set DEMO=true to auto-run DefenseDemoSeeder after db:seed
# and to enable fast rate-limit expiry for live demonstrations.
# Run: php artisan demo:setup
DEMO=false
DEMO_THROTTLE_DECAY_SECONDS=   # e.g. 15 — overrides decay minutes when DEMO=true
DEMO_THROTTLE_ATTEMPTS=        # e.g. 3  — overrides max attempts when DEMO=true

# Super Admin user (created on db:seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Password1!
SUPER_ADMIN_NAME="Super Admin"

# Optional staff user for development
STAFF_USER_EMAIL=test@example.com
STAFF_USER_PASSWORD=password
STAFF_USER_NAME="Test User"
