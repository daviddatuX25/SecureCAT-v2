APP_NAME=SecureCAT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://securecat.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (Laragon MySQL defaults) ──────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=securecat
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Mail (Laragon built-in / MailHog) ──────────────────────
# Laragon includes a mail catcher. For production email, switch
# to a provider like Gmail SMTP, Mailtrap, or Mailgun later.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@securecat.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── PDF Export (Chrome required) ───────────────────────────
LARAVEL_PDF_DRIVER=browsershot
LARAVEL_PDF_CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# ── LibreOffice DOCX→PDF (Optional) ───────────────────────
LIBRE_OFFICE_PATH="C:\Program Files\LibreOffice"
DOCX_CONVERSION_TIMEOUT=120

# ── AI Features (Optional — On-Prem) ──────────────────────
# OpenRouter: Get a free API key at https://openrouter.ai/keys
# Used for the AI Exam Scheduling Assistant.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Mixedbread: Get a free API key at https://www.mixedbread.com/
# Used for the AI Knowledge Companion (RAG embeddings).
MIXEDBREAD_API_KEY=
MIXEDBREAD_STORE_ID=
MIXEDBREAD_BASE_URL=https://api.mixedbread.com/v1

# ── Login Rate Limiting ───────────────────────────────────
LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15

# ── Demo Mode (DO NOT enable in production) ───────────────
DEMO=false

# ── Super Admin Account ───────────────────────────────────
# Change these BEFORE running: php artisan migrate --seed
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Password1!
SUPER_ADMIN_NAME="Super Admin"

# ── Token Expiry ──────────────────────────────────────────
SETUP_TOKEN_EXPIRES_HOURS=72
RESET_TOKEN_EXPIRES_MINUTES=15

# ── Institution Configuration ─────────────────────────────
# These appear on result sheets, admission slips, homepage, and reports.
# Can also be overridden from Setup > Institution in admin UI.
INSTITUTION_NAME="ISPSC"
INSTITUTION_CAMPUS="Tagudin Campus"
INSTITUTION_ADDRESS=""
INSTITUTION_CONTACT_NUMBER=""
INSTITUTION_EMAIL=""
INSTITUTION_WEBSITE=""

# Exam branding
INSTITUTION_EXAM_NAME="ISPSC College Admission Test"
INSTITUTION_EXAM_ACRONYM="ICAT"

# Key Personnel — printed on documents
INSTITUTION_GUIDANCE_COUNSELOR=""
INSTITUTION_GUIDANCE_COUNSELOR_TITLE="Guidance Counselor"
INSTITUTION_GUIDANCE_COUNSELOR_CREDENTIALS=""
INSTITUTION_REGISTRAR=""
INSTITUTION_REGISTRAR_TITLE="Registrar"
INSTITUTION_COLLEGE_PRESIDENT=""
INSTITUTION_COLLEGE_PRESIDENT_TITLE="College President"
INSTITUTION_CAMPUS_DIRECTOR=""
INSTITUTION_CAMPUS_DIRECTOR_TITLE="Campus Director"
INSTITUTION_VP_ACADEMIC_AFFAIRS=""
INSTITUTION_VP_ACADEMIC_AFFAIRS_TITLE="VP for Academic Affairs"
INSTITUTION_DEAN=""
INSTITUTION_DEAN_TITLE="Dean"
INSTITUTION_TESTING_COORDINATOR=""
INSTITUTION_TESTING_COORDINATOR_TITLE="Testing Coordinator"
